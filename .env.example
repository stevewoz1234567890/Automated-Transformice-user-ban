# Copy to ".env" in the repo root (gitignored). Same fields as tfm-secrets JSON — no tfm-secrets.json file is read by the bot.
# Optional: leave unset and use HEADLESS_SECRETS_DUMPER to generate JSON on stdout each run, or HEADLESS_SECRETS_INLINE in bot/config.py.

TFM_SECRETS_SERVER_ADDRESS=
TFM_SECRETS_SERVER_PORTS=11801,12801,13801,14801
TFM_SECRETS_GAME_VERSION=
TFM_SECRETS_CONNECTION_TOKEN=
TFM_SECRETS_AUTH_KEY=
TFM_SECRETS_PACKET_KEY_SOURCES=
TFM_SECRETS_CLIENT_VERIFICATION_TEMPLATE=
