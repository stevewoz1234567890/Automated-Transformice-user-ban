# Repo-root environment for the ban bot. On first run, ".env" is created from this file when missing,
# then any missing BOT_* keys are appended with defaults.
#
# --- Game crypto (required for --headless unless you use dumper or BOT_HEADLESS_SECRETS_INLINE_JSON) ---
# All TFM_SECRETS_* fields must be set for the .env path (see tfm-secrets / your dump).

TFM_SECRETS_SERVER_ADDRESS=
TFM_SECRETS_SERVER_PORTS=11801,12801,13801,14801
TFM_SECRETS_GAME_VERSION=
TFM_SECRETS_CONNECTION_TOKEN=
TFM_SECRETS_AUTH_KEY=
TFM_SECRETS_PACKET_KEY_SOURCES=
TFM_SECRETS_CLIENT_VERIFICATION_TEMPLATE=

# --- Accounts (JSON array, one object per slot) ---
# Keys per row: proxy_port (required), username, password, optional label, optional bind_ip (Proxifier).
# Parser accepts strict JSON, Python single-quoted lists, trailing commas, smart quotes, UTF-8 BOM,
# multiline values (continuation lines until the array parses), and stray text before '['.

BOT_ACCOUNTS_JSON=[{"label":"1","proxy_port":38291,"bind_ip":"127.0.0.1","username":"","password":""}]

# --- Proxy / login behavior ---
BOT_BAN_DELAY_MIN_SEC=1.0
BOT_BAN_DELAY_MAX_SEC=2.0
# Room list: wait per slot attempt; try up to N live slots if the list is empty (unreliable MAIN).
BOT_ROOM_LIST_TIMEOUT_SEC=10.0
BOT_ROOM_LIST_MAX_SLOT_ATTEMPTS=3
# After /room: wait for SetPlayerListPacket (was 12s hardcoded; increase if PARTL during join).
BOT_PLAYER_LIST_COLLECT_TIMEOUT_SEC=25.0
# If true (default), only one slot sends JoinRoom to build the name list. Joining every slot
# at once overloads satellite migration and drops most MAIN connections; others join before
# /ban with BOT_PRE_BAN_ROOM_JOIN_STAGGER_SEC between each.
BOT_PLAYER_LIST_JOIN_LEADER_ONLY=true
BOT_PRE_BAN_ROOM_JOIN_STAGGER_SEC=1.5
# Flash ActionScript error dialog: auto-clicking Continuar/Continue often ends the SWF session
# (same as a manual click — MAIN clean-eof). Prefer Dismiss All / OK; set true only if you want Continuar.
FLASH_ERROR_DISMISS_ALLOW_CONTINUE=false
# Optional: Escape + WM_CLOSE when no safe button matches (default false).
FLASH_ERROR_DISMISS_USE_WMCLOSE=false
# Before each /room menu: one-shot dismiss on Flash Win32 dialogs (safe buttons only unless above).
BOT_BAN_PRE_ROUND_DISMISS_FLASH=true
# Only used when BOT_PLAYER_LIST_JOIN_LEADER_ONLY=false (legacy all-slots name list).
BOT_ROOM_STAGGER_SEC=0.15
BOT_ALL_SLOTS_LOGIN_TIMEOUT_SEC=7200
BOT_PROXY_VERBOSE_LOGIN_FLOW=false
BOT_PROXY_LOG_ALL_MAIN_PACKETS=false
BOT_PROXY_LOGIN_DIAGNOSTICS=true
# Extra MAIN-close line (join / ChangeSat timing, heuristics). Set 0/false/off to disable.
BOT_PROXY_MAIN_CLOSE_DIAG=true
# If true: DEBUG line with ordered srv/cli packet lists when MAIN ends.
BOT_PROXY_MAIN_CLOSE_VERBOSE=false
BOT_PACKET_LOGIN_DELAY_SEC=0.35
BOT_PACKET_LOGIN_START_ROOM=
BOT_PROXY_UPSTREAM_CONNECT_DIAG=true
BOT_UPSTREAM_CONNECT_SHUFFLE_PORTS=false
BOT_PROXY_BIND_HOST=
BOT_PROXY_LISTEN_USE_ACCOUNT_BIND_IP=false
BOT_SHARED_FLASH_SOCKET_POLICY_PORT=10801
# Server-ping handling. "both" (default): proxy ponges immediately AND forwards the ping
# to Flash so Flash's own pong (when it has one) also reaches the server. This is required
# when BOT_PACKET_AUTO_LOGIN=true because Flash never enters its post-login state and
# therefore never pongs on its own — pong=0/0 + clean-eof on every slot is the symptom.
# Other values: "flash" / "0" — forward only (Flash must pong; only viable with the UI
# login flow). "swallow" — proxy-pong only, ping NOT forwarded to Flash.
BOT_AUTO_PONG=both

# --- PARTL retry (relaunch failed Flash tabs after the login phase) ---
# After the initial sequential login phase the bot prints SLOT STATUS AFTER LOGIN PHASE
# and then walks every PARTL slot (logged in but server kicked the upstream) and tries
# to bring it back: close the dead Flash tab, reset proxy session state, optionally
# swap to a different bind_ip, relaunch Flash, wait for a fresh LoginSuccess.
#
# Set BOT_RETRY_FAILED_SLOTS=false to disable; set BOT_RETRY_MAX_ATTEMPTS=0 likewise.
BOT_RETRY_FAILED_SLOTS=true
BOT_RETRY_MAX_ATTEMPTS=3
BOT_RETRY_DELAY_SEC=3.0
BOT_RETRY_LOGIN_TIMEOUT_SEC=120.0
#
# Optional global pool of spare bind_ips that any failing slot can borrow from.
# Format: comma-, semicolon-, or space-separated list of IPs. Each IP is issued
# at most once across the whole retry pass.
#
# IMPORTANT: setting a different bind_ip only changes the *WAN exit IP* the game
# server sees if one of these is true:
#   * PROXY_LISTEN_USE_ACCOUNT_BIND_IP=true and each IP is a real NIC alias on
#     this machine (the bot binds the upstream socket to that NIC), OR
#   * Proxifier (or whichever SOCKS shim you run) has a rule keyed on that IP
#     mapping to a distinct upstream proxy.
# Without one of those, rotating bind_ip is just relabelling — useful for
# diagnostics, but the server still sees the same public IP.
BOT_SPARE_BIND_IPS=
# Per-account extras live inside BOT_ACCOUNTS_JSON as an "extra_bind_ips" list, e.g.:
#   {"label":"1","proxy_port":38291,"bind_ip":"10.47.103.2",
#    "extra_bind_ips":["10.47.103.99","10.47.103.100"], ...}

# --- Headless TCP login ---
BOT_HEADLESS_AUTO_LOGIN=false
BOT_HEADLESS_SECRETS_DOTENV_PATH=.env
BOT_HEADLESS_SECRETS_SEED_DOTENV_FROM_EXAMPLE=true
BOT_HEADLESS_SECRETS_ENV_PREFIX=TFM_SECRETS_
BOT_HEADLESS_SECRETS_INLINE_JSON=
# Leave empty to auto-run ``tfm-secrets`` when TFM_SECRETS_* in .env is incomplete (default).
BOT_HEADLESS_SECRETS_DUMPER=
BOT_HEADLESS_SECRETS_AUTO_DUMPER=true
# Auto-run TFMSecretsLeaker.swf via flashplayer_32_sa_debug.exe in repo root (or FLASHPLAYER_DEBUG).
BOT_HEADLESS_SECRETS_AUTO_LEAKER_SWF=true
# If set, pip install -U this spec when tfm-secrets is missing (before Flash leaker).
BOT_HEADLESS_SECRETS_AUTO_PIP_BEFORE_DUMPER=true
BOT_HEADLESS_SECRETS_PERSIST_DUMP_TO_DOTENV=true
BOT_HEADLESS_SECRETS_DUMPER_TIMEOUT_SEC=120
# Run tfm-secrets / Flash leaker on each headless run before using cached TFM_SECRETS_* (then fall back to .env).
BOT_HEADLESS_SECRETS_ALWAYS_REFRESH=true
BOT_HEADLESS_CONNECT_TO_SATELLITE=true
# After LoginSuccess, drop the caseus TCP session so the next slot's headless client can connect (default true).
BOT_HEADLESS_EXIT_AFTER_LOGIN_SUCCESS=true
BOT_HEADLESS_LOGIN_STAGGER_SEC=6
# After WinError 121 on a slot, add this many seconds to the pause before the next slot (capped below).
BOT_HEADLESS_STAGGER_WIN121_EXTRA_SEC=4
BOT_HEADLESS_STAGGER_MAX_SEC=15
# Stop after N consecutive slots without LoginSuccess (0 = never). Default 3 avoids hammering upstream when logins are already failing.
BOT_HEADLESS_STOP_AFTER_CONSECUTIVE_LOGIN_FAILURES=3

# --- Upstream (real game host; leave empty to use values from the secrets dump) ---
# On headless startup, write BOT_UPSTREAM_* from the dump, set dump-only, clear address mismatch (disable to manage upstream manually).
BOT_UPSTREAM_AUTO_SYNC_FROM_SECRETS=true
BOT_UPSTREAM_FROM_SECRETS_DUMP_ONLY=false
BOT_UPSTREAM_PORTS_MATCH_DUMP_ORDER=true
BOT_UPSTREAM_STRICT_MATCH_SECRETS_DUMP=false
# Only if you know you need it: allow BOT_UPSTREAM_SERVER_ADDRESS to differ from TFM_SECRETS_SERVER_ADDRESS.
BOT_UPSTREAM_ALLOW_ADDRESS_MISMATCH=false
BOT_UPSTREAM_SERVER_ADDRESS=
BOT_UPSTREAM_SERVER_PORTS=
BOT_UPSTREAM_MAIN_GAME_PORT_TRY_FIRST=11801
BOT_UPSTREAM_TCP_PROBE_BEFORE_HEADLESS=true
# If the parallel probe gets 0/N ports, exit before starting proxies/headless (set false to try despite probe).
BOT_UPSTREAM_ABORT_ON_PROBE_ALL_FAILED=true
BOT_UPSTREAM_PROBE_TIMEOUT_SEC=6

# --- Optional pip before imports (non-frozen runs only) ---
BOT_PIP_INSTALL_CASEUS_GIT_UPGRADE=false
BOT_CASEUS_GIT_PIP_SPEC=caseus @ git+https://github.com/friedkeenan/caseus.git
BOT_PIP_INSTALL_TFM_SECRETS_CLI=false
BOT_TFM_SECRETS_PIP_INSTALL_SPEC=
