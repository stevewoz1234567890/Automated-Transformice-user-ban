# Repo root environment for the ban bot. You can list only accounts here — other options default
# from `bot/bot_env_defaults.py` — or add any `TFM_SECRETS_*` / `BOT_*` lines here; they override
# those code defaults. If `tfm-secrets.json` exists in the repo root (from
# `scripts/export_tfm_secrets_json.py`), its fields fill any TFM keys that are still unset
# (set `BOT_MERGE_TFM_SECRETS_JSON=false` to disable). See README "Crypto secrets".
#
# One JSON array of account objects per slot. Keys: proxy_port (required), optional username, password,
# label, bind_ip, extra_bind_ips, etc. Parser accepts strict JSON, Python list syntax, and multiline
# values when the array spans several lines.
BOT_ACCOUNTS_JSON=[{"label":"1","proxy_port":38291,"bind_ip":"127.0.0.1","username":"","password":""}]

# ── Optional: deep logging for client/secrets/loader drift ("issue 1") ─────────────────────────────
# BOT_ISSUE1_FORENSIC=true forces ROOT_CAUSE_MAIN_CLOSE, verbose login flow, wider MAIN packet rings,
# longer ActionScript dialog captures; enables per-dismiss ISSUE1_AS_DISMISS_ACTION unless BOT_ISSUE1_AS_DISMISS_LOG=false.
# Grep log.txt for: ISSUE1_HANDSHAKE_PROBE ISSUE1_HANDSHAKE_GV_MISMATCH ISSUE1_MAIN_CLOSE ISSUE1_AS_FIRST_FP
# ROOT_CAUSE_MAIN_CLOSE ISSUE1_DISMISS_CUE ISSUE1_PRIMARY_SUSPECT ISSUE1_LOADER_PREFLIGHT ISSUE1_AS_DISMISS_ACTION.
# BOT_ISSUE1_HANDSHAKE_PROBE=false quiets per-connection handshake INFO lines (default true).

# ── Large farms (14+ Flash): stagger reduces overlapping MAIN/sat login / mass PARTL clean-eof ─────
# Default BOT_UI_FLASH_LAUNCH_STAGGER_SEC is 3.5s with auto floors (7s minimum gap when opening slot 14).
# Raise further if CPU or disk is slow. Rare: BOT_PROXY_HANDSHAKE_LOADER_STAGE_SIZE=0x1FBD (omit for default)
# — override only if handshake loader_stage_size must match non-default live-server tooling.
#
# Post-login ActionScript sweep (late error dialogs): defaults avoid BM_CLICK on sole "Continuar"
# (drops MAIN like a manual click). BOT_POST_LOGIN_AS_SWEEP_CONTINUE_IF_SOLE_OPTION=true restores
# legacy behavior; BOT_POST_LOGIN_AS_SWEEP_USE_WMCLOSE=false disables WM_CLOSE fallback on the popup.
# BOT_POST_LOGIN_AS_SWEEP_ADOBE_ESCAPE_WMCLOSE_ONLY=true (default): sweep never BM_CLICK Adobe AS dialogs
# (even Descartar/Dismiss)—only Escape+WM_CLOSE—to avoid OK slots flipping PARTL (issue 1 / as_sweep).
# The same USE_WMCLOSE / ADOBE_ESCAPE_WMCLOSE_ONLY settings apply to the login-phase Flash error poll
# (FLASH_FLASHPLAYER_ERROR_DISMISS_POLL_SEC), not sole-Continuar—that remains sweep-only via CONTINUE_IF_SOLE.
#
# Correlation diagnostics (issue 1): ROOT_CAUSE_MAIN_CLOSE may append issue1_near_as_dismiss=N.N|tail .
# BOT_ISSUE1_AS_MAIN_CORR_WINDOW_SEC=12 (0 disables appendix). BOT_ISSUE1_SWEEP_BOUNDARY_LOG=false
# turns off WARNING-level ISSUE1_SWEEP_BEGIN / ISSUE1_SWEEP_END.
# Greps: ISSUE1_DISMISS_CUE= (structured tokens after dismiss), ISSUE1_PRIMARY_SUSPECT= (clean-eof heuristics),
# ISSUE1_AS_DISMISS_ACTION (every dismiss when BOT_ISSUE1_AS_DISMISS_LOG=true — on by default with BOT_ISSUE1_FORENSIC).
# BOT_POST_LOGIN_AS_SWEEP_INTER_SLOT_PAUSE_SEC=0 (default); small value (e.g. 0.08) spaces WM_CLOSE
# between slots inside each sweep pass.
